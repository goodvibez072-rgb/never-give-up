# AmourScans Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER CONFIGURATION (Required)
# =============================================================================

NODE_ENV=production
PORT=3000

# Your full domain URL — used for OAuth callbacks, CORS, and DMCA email links
SITE_URL=https://amurscans.com

# =============================================================================
# DATABASE CONFIGURATION (Required for VPS — use absolute paths)
# =============================================================================

DATABASE_PATH=/var/www/amurscans/data/database.db
SESSIONS_PATH=/var/www/amurscans/data/sessions.db

# Local storage path for chapter images served via /api/chapters/image/
STORAGE_PATH=/var/www/amurscans/data/storage

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_password_here

# =============================================================================
# SECURITY (Auto-generated on first start if not set — OK to leave blank)
# =============================================================================

# SESSION_SECRET=leave-blank-to-auto-generate
# CSRF secrets are stored in data/csrf-secret.key automatically

# =============================================================================
# EMAIL CONFIGURATION (Optional — site runs fine without it)
# =============================================================================
# Used for: email verification, password reset, DMCA notifications
# If not configured, email sends are silently skipped (logged as warnings)

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=AmourScans <noreply@amurscans.com>
# SMTP_SECURE=false      # Set to true for port 465 (SSL), false for 587 (STARTTLS)

# Email for receiving DMCA notices
# DMCA_NOTIFICATION_EMAIL=admin@yourdomain.com

# =============================================================================
# PAYMENT INTEGRATION (Optional — for coin purchases)
# =============================================================================

# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# OAUTH PROVIDERS (Optional — for Google/Discord social login)
# =============================================================================

# Google OAuth (https://console.cloud.google.com/)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Discord OAuth (https://discord.com/developers/applications)
# DISCORD_CLIENT_ID=your_discord_client_id
# DISCORD_CLIENT_SECRET=your_discord_client_secret

# =============================================================================
# NOTES
# =============================================================================
# - DATABASE_PATH and SESSIONS_PATH must be ABSOLUTE paths on VPS
# - SITE_URL must NOT have a trailing slash
# - After editing .env: sudo systemctl restart amurscans
